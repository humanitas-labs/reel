{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Tape - Development",
	"identifier": "com.andjones.tape.dev",
	"mainBinaryName": "Tape - Development",
	"build": {
		"beforeDevCommand": "bun run localdev",
		"devUrl": "http://localhost:3002",
		"beforeBuildCommand": "bun run turbo build --filter @cap/desktop",
		"frontendDist": "../.output/public"
	},
	"app": {
		"macOSPrivateApi": true,
		"security": {
			"csp": "default-src 'self' ws: ipc: http://ipc.localhost; connect-src 'self' ws: wss: ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'",
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$APPDATA/**",
					"**/*.jpg",
					"**/*.webp",
					"**/*.mp3",
					"**/*.wav",
					"**/*.m4a",
					"**/*.ogg",
					"**/*.flac",
					"**/*.aac",
					"$RESOURCE/**",
					"**/*.riv",
					"$HOME/**"
				]
			}
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["tape"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": false,
		"targets": "all",
		"externalBin": ["binaries/cap-muxer", "binaries/cap-exporter"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/macos/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"assets/backgrounds/macOS/*": "assets/backgrounds/macOS/",
			"assets/backgrounds/blue/*": "assets/backgrounds/blue/",
			"assets/backgrounds/cities/*": "assets/backgrounds/cities/",
			"assets/backgrounds/dark/*": "assets/backgrounds/dark/",
			"assets/backgrounds/orange/*": "assets/backgrounds/orange/",
			"assets/backgrounds/purple/*": "assets/backgrounds/purple/",
			"../src/assets/rive/*.riv": "assets/rive/",
			"../src/assets/music/*.mp3": "assets/music/"
		},
		"macOS": {
			"minimumSystemVersion": "12.3",
			"dmg": {
				"background": "assets/dmg-background.png",
				"appPosition": {
					"x": 180,
					"y": 140
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 140
				}
			},
			"frameworks": ["../../../target/native-deps/Spacedrive.framework"]
		},
		"fileAssociations": [
			{
				"ext": ["cap"],
				"name": "Tape Project",
				"mimeType": "application/x-cap-project",
				"role": "Editor"
			}
		]
	}
}
